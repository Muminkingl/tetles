NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_SERVICE_ROLE_KEY=
DATABASE_URL=
# Server-only, random base64url-encoded key (at least 32 bytes); never use a NEXT_PUBLIC_ name.
TETHER_COOKIE_SECRET=
# Server-only project API key consumed by the SDK to obtain a signed license.
TETHER_KEY=
TETHER_PROJECT_ID=
# Exact issuer URL embedded in license tokens. Keep this stable for a deployment.
TETHER_LICENSE_ISSUER=http://localhost:3000
# Optional: set only to override NODE_ENV-based production/development detection.
# TETHER_ENV=
# Optional escape hatch for starting a production app without a usable license.
# TETHER_ALLOW_UNLICENSED=false
# Optional endpoint overrides; defaults are derived from TETHER_LICENSE_ISSUER.
# TETHER_LICENSE_ENDPOINT=
# TETHER_JWKS_ENDPOINT=
# Server-only ES256 private JWK, base64url-encoded JSON. Generate with pnpm license:keygen.
TETHER_LICENSE_SIGNING_PRIVATE_JWK_B64=
TETHER_LICENSE_SIGNING_KID=
