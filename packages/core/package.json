{
  "name": "@tether/core",
  "version": "0.1.0",
  "type": "module",
  "files": ["src", "dist"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./access-token-hash": {
      "types": "./src/access-token-hash.ts",
      "import": "./dist/access-token-hash.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark": "node ./scripts/benchmark-verifier.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "vitest": "^5.0.3"
  }
}
