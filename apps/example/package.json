{
  "name": "tether-supabase-next-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tether/core build && pnpm --filter @tether/client build && pnpm --filter @tether/next build && dotenv -e ../../.env -- next dev",
    "build": "node ./scripts/build-with-license-snapshot.mjs --build",
    "build:bootstrap": "pnpm --filter @tether/core build && pnpm --filter @tether/client build && pnpm --filter @tether/next build && next build",
    "start": "dotenv -e ../../.env -- next start",
    "license:pull": "node ./scripts/build-with-license-snapshot.mjs --pull-only",
    "issue-key": "dotenv -e ../../.env -- node ./scripts/issue-project-key.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tether/client": "workspace:*",
    "@tether/core": "workspace:*",
    "@tether/next": "workspace:*",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "16.6.1",
    "dotenv-cli": "^11.0.0"
  }
}
